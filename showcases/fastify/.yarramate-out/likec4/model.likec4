views {
  view framework-overview {
    title 'Fastify framework overview'
    include appDeveloper, contentTypeParser, depAjv, depAvvio, depFindMyWay, depFjs, depLightMyRequest, depPino, encapsulationContext, errorHandling, framework, hookSystem, instanceFactory, jsonSchemas, logging, nodeHttp, pluginEngine, publicApi, requestReply, routeDefinition, router, schemaEngine, serverAdapter
    exclude * -> *
    include * -> * where metadata.yarramateId is 'fastify#ajv-serves-schema'
    include * -> * where metadata.yarramateId is 'fastify#api-serves-developer'
    include * -> * where metadata.yarramateId is 'fastify#avvio-serves-plugin-engine'
    include * -> * where metadata.yarramateId is 'fastify#errors-serve-reply'
    include * -> * where metadata.yarramateId is 'fastify#factory-realizes-api'
    include * -> * where metadata.yarramateId is 'fastify#fjs-serves-schema'
    include * -> * where metadata.yarramateId is 'fastify#fmw-serves-router'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-ctp'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-error-handling'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-factory'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-hooks'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-logging'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-plugin-engine'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-request-reply'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-router'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-schema-engine'
    include * -> * where metadata.yarramateId is 'fastify#framework-has-server-adapter'
    include * -> * where metadata.yarramateId is 'fastify#lifecycle-reads-routes'
    include * -> * where metadata.yarramateId is 'fastify#lmr-serves-factory'
    include * -> * where metadata.yarramateId is 'fastify#nodehttp-serves-server'
    include * -> * where metadata.yarramateId is 'fastify#pino-serves-logging'
    include * -> * where metadata.yarramateId is 'fastify#router-stores-routes'
    include * -> * where metadata.yarramateId is 'fastify#schema-serves-reply'
    include * -> * where metadata.yarramateId is 'fastify#schema-stores-schemas'
    autoLayout LeftRight
  }
  dynamic view request-lifecycle {
    title 'Request lifecycle'
    fnAccept -> fnRouting {
      description 'The server passes each accepted request to router lookup via the wrapped routing handler (fastify.js:106, lib/route.js:114).'
    }
    fnRouting -> fnRequestHooks {
      description 'After route match, the onRequest hook chain starts (lib/route.js:560-566).'
    }
    fnRequestHooks -> fnParsing {
      description 'After preParsing, the content-type parser consumes the body (lib/route.js:654-657, lib/handle-request.js:73 and :87).'
    }
    fnParsing -> fnValidation {
      description 'The parsed body enters preValidation and compiled schema validation (lib/handle-request.js validateSchema).'
    }
    fnValidation -> routeHandler {
      description 'On successful validation, the preHandler chain runs and the user handler is invoked (lib/handle-request.js preHandlerHookRunner).'
    }
    routeHandler -> fnSerialization {
      description 'The handler result (reply.send or async return wrapped by lib/wrap-thenable.js) enters preSerialization and serialization (lib/reply.js:207,227).'
    }
    fnSerialization -> fnRespond {
      description 'The serialized payload passes through onSend hooks and is written to the raw response (lib/reply.js:167,232,340).'
    }
  }
  dynamic view plugin-registration {
    title 'Plugin registration and encapsulation'
    publicApi -> fnRegister {
      description 'register(plugin, opts) queues the plugin on the avvio boot queue (fastify.js:360-378).'
    }
    fnRegister -> encapsulationContext {
      description 'The avvio override creates an encapsulated child instance with copied hooks, schemas, parsers and prototypes (lib/plugin-override.js:39-51).'
    }
    fnRegister -> fnAppHooks {
      description 'onRegister hooks fire for every new encapsulated instance (lib/plugin-override.js:71).'
    }
  }
}
