    include * -> * where metadata.yarramateId is 'kafka#broker-appends-log'
    include * -> * where metadata.yarramateId is 'kafka#broker-composes-log-manager'
    include * -> * where metadata.yarramateId is 'kafka#broker-composes-replica-fetcher'
    include * -> * where metadata.yarramateId is 'kafka#broker-composes-replica-manager'
    include * -> * where metadata.yarramateId is 'kafka#broker-manages-partition'
    include * -> * where metadata.yarramateId is 'kafka#broker-replicates-followers'
    include * -> * where metadata.yarramateId is 'kafka#log-appends-segment'
    include * -> * where metadata.yarramateId is 'kafka#log-manager-composes-partition-log'
    include * -> * where metadata.yarramateId is 'kafka#partition-log-composes-segment'
    include * -> * where metadata.yarramateId is 'kafka#replica-manager-manages-hw'
    include * -> * where metadata.yarramateId is 'kafka#replica-manager-manages-isr'
    include * -> * where metadata.yarramateId is 'kafka#replica-manager-manages-replicas'
    include * -> * where metadata.yarramateId is 'kafka#topic-composes-partition'
    autoLayout LeftRight
  }
  view metadata-plane {
    title 'KRaft metadata plane'
    description 'The control plane: the controller quorum runs Raft consensus over the single __cluster_metadata log; committed records become a metadata image published to every node\'s in-memory cache.'
    include broker, clusterMetadataCache, controller, controllerQuorum, kafkaCluster, metadataLog, metadataPublisher, raftConsensus, topicPartition
    exclude * -> *
    include * -> * where metadata.yarramateId is 'kafka#broker-composes-metadata-cache'
    include * -> * where metadata.yarramateId is 'kafka#broker-manages-partition'
    include * -> * where metadata.yarramateId is 'kafka#broker-reads-metadata-cache'
    include * -> * where metadata.yarramateId is 'kafka#cluster-composes-broker'
    include * -> * where metadata.yarramateId is 'kafka#cluster-composes-controller-quorum'
    include * -> * where metadata.yarramateId is 'kafka#cluster-composes-metadata-log'
    include * -> * where metadata.yarramateId is 'kafka#controller-composes-metadata-cache'
    include * -> * where metadata.yarramateId is 'kafka#controller-composes-raft'
    include * -> * where metadata.yarramateId is 'kafka#controller-manages-partitions'
    include * -> * where metadata.yarramateId is 'kafka#controller-writes-metadata-log'
    include * -> * where metadata.yarramateId is 'kafka#metadata-log-to-publisher'
    include * -> * where metadata.yarramateId is 'kafka#publisher-updates-cache'
    include * -> * where metadata.yarramateId is 'kafka#quorum-aggregates-controller'
    include * -> * where metadata.yarramateId is 'kafka#raft-replicates-metadata-log'
    autoLayout LeftRight
  }
  dynamic view produce-path {
    title 'Produce path'
    description 'Ordered flow: the producer sends a Produce request to the partition leader broker, which appends records to the active log segment, replicates to follower replicas within the ISR, advances the high watermark, and acknowledges the producer (acks=all).'
    producerClient -> broker {
      description 'The Sender builds a ProduceRequest with the configured acks and sends ready batches to the partition leader.'
    }
    broker -> partitionLog {
      description 'handleProduceRequest routes to ReplicaManager, which appends to the leader\'s UnifiedLog via appendAsLeader.'
    }
    partitionLog -> logSegment {
      description 'UnifiedLog.append writes to the active LogSegment, assigning offsets and updating the offset/time indexes.'
    }
    broker -> replicaFetcher {
      description 'The leader broker serves fetch requests from follower brokers\' replica fetcher threads.'
    }
    replicaManager -> inSyncReplicaSet {
      description 'ReplicaManager periodically shrinks the ISR and expands it as followers catch up.'
    }
    replicaManager -> highWatermark {
      description 'ReplicaManager advances the high watermark to the minimum log-end offset across the ISR.'
    }
    broker -> producerClient {
      description 'With acks=all the leader waits until the record is replicated to the whole ISR before acknowledging the producer.'
    }
  }
  dynamic view consumer-group-coordination {
    title 'Consumer-group coordination'
    description 'Ordered flow: the consumer joins its group at the coordinator, the cooperative-sticky assignor computes the partition assignment, the coordinator delivers it, the consumer polls records from leaders, and commits offsets to the __consumer_offsets topic.'
    consumerClient -> groupCoordinator {
      description 'The consumer\'s coordinator joins (or rejoins) the group and heartbeats to stay alive.'
    }
    partitionAssignor -> consumerGroup {
      description 'The group-leader consumer runs the assignor to map partitions to members.'
    }
    groupCoordinator -> consumerClient {
      description 'The coordinator delivers each member\'s assignment through the sync/heartbeat response.'
    }
    consumerClient -> broker {
      description 'The consumer\'s Fetcher issues Fetch requests to partition leaders and returns the collected records.'
    }
    consumerClient -> groupCoordinator {
      description 'The consumer commits offsets (sync or async) to its group coordinator.'
    }
    groupCoordinator -> consumerOffsets {
      description 'The group coordinator commits and reads offsets in the __consumer_offsets topic.'
    }
  }
}
