    include * -> * where metadata.yarramateId is 'miniflux#storage-manages-users'
    autoLayout LeftRight
  }
  dynamic view feed-refresh-flow {
    title 'Background feed refresh flow'
    description 'Ordered flow: the scheduler selects due feeds and dispatches jobs, the worker pool runs RefreshFeed, the pipeline fetches and processes feed documents, new entries are persisted, and enabled integrations are notified.'
    feedScheduler -> feed {
      description 'The batch builder selects enabled feeds whose next-check time has expired, bounded per host.'
    }
    feedScheduler -> workerPool {
      description 'Every polling tick, due-feed jobs are pushed onto the shared worker pool.'
    }
    workerPool -> feedPipeline {
      description 'Each worker goroutine executes RefreshFeed for one job.'
    }
    feedPublisher -> feedPipeline {
      description 'The pipeline fetches the feed URL over HTTP with conditional requests (ETag/Last-Modified).'
    }
    feedPipeline -> storage {
      description 'New and updated entries are persisted through RefreshFeedEntries.'
    }
    feedPipeline -> integrationHub {
      description 'After a refresh stores new entries, they are pushed asynchronously to the user\'s enabled integrations.'
    }
    integrationHub -> integrationTarget {
      description 'Entries are delivered to each enabled third-party service.'
    }
  }
  dynamic view save-entry-flow {
    title 'Save entry to third-party services'
    description 'Ordered flow: the reader saves an entry in the web UI, which invokes SendEntry on the integration hub, and the entry is delivered to each third-party service the user enabled.'
    reader -> webUi {
      description 'The reader clicks Save on an entry.'
    }
    webUi -> integrationHub {
      description 'Saving an entry invokes SendEntry for the user\'s enabled third-party providers.'
    }
    integrationHub -> integrationTarget {
      description 'Entries are delivered to each enabled third-party service.'
    }
  }
}
