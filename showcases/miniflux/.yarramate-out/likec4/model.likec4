  view http-surfaces {
    title 'HTTP surfaces and clients'
    description 'Entry points of the Miniflux HTTP server: the web UI for people, three API dialects for third-party clients, the media proxy, and the shared storage layer behind all of them.'
    include clientApp, feverApi, greaderApi, mediaProxy, oidcProvider, reader, restApi, storage, webUi
    exclude * -> *
    include * -> * where metadata.yarramateId is 'miniflux#fever-serves-clients'
    include * -> * where metadata.yarramateId is 'miniflux#greader-serves-clients'
    include * -> * where metadata.yarramateId is 'miniflux#mediaproxy-serves-reader'
