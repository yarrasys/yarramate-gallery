    include * -> * where metadata.yarramateId is 'miniflux#webui-serves-reader'
    autoLayout LeftRight
  }
  view persistence {
    title 'Persistence and principal information'
    description 'The storage layer owns all SQL against PostgreSQL and manages the three principal information objects: feed subscriptions, entries, and user accounts.'
    include entry, feed, postgresql, storage, userAccount
    exclude * -> *
    include * -> * where metadata.yarramateId is 'miniflux#pg-serves-storage'
    include * -> * where metadata.yarramateId is 'miniflux#storage-manages-entries'
