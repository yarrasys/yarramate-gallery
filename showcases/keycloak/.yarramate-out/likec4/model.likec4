views {
  view system-overview {
    title 'Keycloak system overview'
    description 'Repository orientation: the Keycloak Quarkus server, its internal services, the protocol and admin surfaces, the actors and external systems around it, and its principal information, as observed at tag 26.7.1.'
    include accountService, adminRestApi, administrator, authenticationFlowEngine, authorizationResource, authorizationService, client, clientApplication, clientScope, credential, endUser, externalIdp, group, identityBroker, infinispanCache, jpaStore, keycloakServer, ldapDirectory, oidcProtocolEndpoint, policyEnforcer, protocolMapper, realm, relationalDatabase, role, samlProtocolEndpoint, spiProviderModel, tokenService, user, userFederation, userSession
    exclude * -> *
    include * -> * where metadata.yarramateId is 'keycloak#account-service-serves-end-user'
    include * -> * where metadata.yarramateId is 'keycloak#admin-rest-api-serves-administrator'
    include * -> * where metadata.yarramateId is 'keycloak#auth-engine-looks-up-user'
    include * -> * where metadata.yarramateId is 'keycloak#auth-engine-returns-to-oidc'
    include * -> * where metadata.yarramateId is 'keycloak#auth-engine-uses-federation'
    include * -> * where metadata.yarramateId is 'keycloak#broker-maps-user'
    include * -> * where metadata.yarramateId is 'keycloak#broker-redirects-to-idp'
    include * -> * where metadata.yarramateId is 'keycloak#broker-returns-to-oidc'
    include * -> * where metadata.yarramateId is 'keycloak#cache-fronts-store'
    include * -> * where metadata.yarramateId is 'keycloak#client-requests-oidc'
    include * -> * where metadata.yarramateId is 'keycloak#db-serves-store'
    include * -> * where metadata.yarramateId is 'keycloak#enforcer-checks-authz'
