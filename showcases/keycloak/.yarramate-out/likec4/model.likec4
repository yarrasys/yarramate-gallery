    include * -> * where metadata.yarramateId is 'keycloak#oidc-hands-to-auth-engine'
    include * -> * where metadata.yarramateId is 'keycloak#oidc-issues-token'
    include * -> * where metadata.yarramateId is 'keycloak#protocol-mapper-serves-token'
    include * -> * where metadata.yarramateId is 'keycloak#saml-endpoint-serves-clients'
    include * -> * where metadata.yarramateId is 'keycloak#server-composes-account-service'
    include * -> * where metadata.yarramateId is 'keycloak#server-composes-admin-rest-api'
    include * -> * where metadata.yarramateId is 'keycloak#server-composes-auth-engine'
