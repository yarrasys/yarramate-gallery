    include * -> * where metadata.yarramateId is 'keycloak#server-composes-cache'
    include * -> * where metadata.yarramateId is 'keycloak#server-composes-identity-broker'
    include * -> * where metadata.yarramateId is 'keycloak#server-composes-jpa-store'
    include * -> * where metadata.yarramateId is 'keycloak#server-composes-oidc-endpoint'
    include * -> * where metadata.yarramateId is 'keycloak#server-composes-protocol-mapper'
    include * -> * where metadata.yarramateId is 'keycloak#server-composes-saml-endpoint'
