    include * -> * where metadata.yarramateId is 'keycloak#token-issued-to-client'
    autoLayout LeftRight
  }
  view protocol-surfaces {
    title 'Protocol and administration surfaces'
    description 'The externally meaningful entry points: the OIDC/OAuth 2.0 and SAML 2.0 protocol endpoints for client applications, and the admin and account surfaces for administrators and end users.'
    include accountService, adminRestApi, administrator, clientApplication, endUser, oidcProtocolEndpoint, samlProtocolEndpoint, tokenService
    exclude * -> *
    include * -> * where metadata.yarramateId is 'keycloak#account-service-serves-end-user'
    include * -> * where metadata.yarramateId is 'keycloak#admin-rest-api-serves-administrator'
    include * -> * where metadata.yarramateId is 'keycloak#client-requests-oidc'
    include * -> * where metadata.yarramateId is 'keycloak#oidc-endpoint-serves-clients'
    include * -> * where metadata.yarramateId is 'keycloak#oidc-issues-token'
    include * -> * where metadata.yarramateId is 'keycloak#saml-endpoint-serves-clients'
    include * -> * where metadata.yarramateId is 'keycloak#token-issued-to-client'
    autoLayout LeftRight
  }
  view authorization-services {
    title 'Authorization services and policy enforcement'
    description 'Fine-grained authorization: resources, scopes, and policies persisted through the JPA store and evaluated by the authorization services, enforced at the client side by the policy enforcer.'
    include authorizationResource, authorizationService, clientApplication, jpaStore, policyEnforcer, tokenService
    exclude * -> *
    include * -> * where metadata.yarramateId is 'keycloak#enforcer-checks-authz'
    include * -> * where metadata.yarramateId is 'keycloak#enforcer-protects-client'
    include * -> * where metadata.yarramateId is 'keycloak#store-manages-authz-resource'
    include * -> * where metadata.yarramateId is 'keycloak#store-serves-authz'
    include * -> * where metadata.yarramateId is 'keycloak#store-serves-token-service'
    include * -> * where metadata.yarramateId is 'keycloak#token-issued-to-client'
    autoLayout LeftRight
  }
  dynamic view direct-login-flow {
    title 'Direct login flow (OIDC authorization code)'
    description 'Ordered flow: a client application requests authorization, the OIDC endpoint hands off to the authentication flow, the flow resolves the user and validates credentials against the local store (and, for federated users, the user-federation bridge), an authorization code is issued, and tokens are minted and returned to the client.'
    clientApplication -> oidcProtocolEndpoint {
      description 'The client application redirects the user to, and exchanges codes at, the OIDC endpoints.'
    }
    oidcProtocolEndpoint -> authenticationFlowEngine {
      description 'The protocol endpoint hands authentication off to the configured login flow.'
    }
    authenticationFlowEngine -> jpaStore {
      description 'The flow resolves the local user and validates its stored credentials.'
    }
    authenticationFlowEngine -> userFederation {
      description 'For federated users the flow validates credentials through the user-federation bridge.'
    }
    authenticationFlowEngine -> oidcProtocolEndpoint {
      description 'On success the flow completes and an authorization code is issued back to the protocol endpoint.'
    }
    oidcProtocolEndpoint -> tokenService {
      description 'The token endpoint exchanges the code for access, ID, and refresh tokens.'
    }
    tokenService -> clientApplication {
      description 'The minted tokens (or SAML assertions) are returned to the client application.'
    }
  }
  dynamic view brokered-login-flow {
    title 'Brokered login flow'
    description 'Ordered flow: the OIDC endpoint routes login through the identity broker, the broker redirects to and is called back by an external identity provider, the returned identity is mapped onto a realm user, and tokens are minted and returned to the client.'
    clientApplication -> oidcProtocolEndpoint {
      description 'The client application redirects the user to, and exchanges codes at, the OIDC endpoints.'
    }
    oidcProtocolEndpoint -> identityBroker {
      description 'The protocol endpoint routes the login through the identity broker to an external provider.'
    }
    identityBroker -> externalIdp {
      description 'The broker redirects the user to the configured external identity provider.'
    }
    externalIdp -> identityBroker {
      description 'The external provider returns an authenticated identity to the broker callback.'
    }
    identityBroker -> jpaStore {
      description 'The broker maps the returned identity onto an existing or newly provisioned realm user.'
    }
    identityBroker -> oidcProtocolEndpoint {
      description 'The broker completes the first/post-broker login flow and hands control back to the protocol endpoint.'
    }
    oidcProtocolEndpoint -> tokenService {
      description 'The token endpoint exchanges the code for access, ID, and refresh tokens.'
    }
    tokenService -> clientApplication {
      description 'The minted tokens (or SAML assertions) are returned to the client application.'
    }
  }
}
