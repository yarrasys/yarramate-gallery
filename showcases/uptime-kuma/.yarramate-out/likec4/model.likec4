  }
  appDatabase -[realization]-> monitorConfig {
    description 'Configuration tables are held in the relational store.'
    metadata {
      yarramateId 'uptime-kuma#db-persists-config'
      yarramateKind 'yarramate/core@0.1#realization'
    }
  }
  appDatabase -[realization]-> heartbeatHistory {
    description 'Heartbeat and aggregate stat tables are held in the relational store.'
    metadata {
      yarramateId 'uptime-kuma#db-persists-heartbeats'
      yarramateKind 'yarramate/core@0.1#realization'
    }
  }
  monitorEngine -[flow]-> monitoredTarget {
    description 'Each monitor type actively probes its configured target on an interval.'
    metadata {
      yarramateId 'uptime-kuma#engine-probes-target'
