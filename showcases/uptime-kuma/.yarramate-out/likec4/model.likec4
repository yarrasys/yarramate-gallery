    include * -> * where metadata.yarramateId is 'uptime-kuma#core-starts-monitors'
    include * -> * where metadata.yarramateId is 'uptime-kuma#core-streams-events'
    include * -> * where metadata.yarramateId is 'uptime-kuma#db-persists-config'
    include * -> * where metadata.yarramateId is 'uptime-kuma#db-persists-heartbeats'
    include * -> * where metadata.yarramateId is 'uptime-kuma#engine-probes-target'
    include * -> * where metadata.yarramateId is 'uptime-kuma#engine-reads-config'
    include * -> * where metadata.yarramateId is 'uptime-kuma#engine-realizes-monitoring'
    include * -> * where metadata.yarramateId is 'uptime-kuma#engine-records-heartbeats'
    include * -> * where metadata.yarramateId is 'uptime-kuma#engine-triggers-notifications'
    include * -> * where metadata.yarramateId is 'uptime-kuma#hub-delivers-alerts'
    include * -> * where metadata.yarramateId is 'uptime-kuma#monitoring-serves-operator'
    include * -> * where metadata.yarramateId is 'uptime-kuma#runtime-hosts-core'
    include * -> * where metadata.yarramateId is 'uptime-kuma#status-serves-visitor'
    include * -> * where metadata.yarramateId is 'uptime-kuma#ui-serves-operator'
    autoLayout LeftRight
  }
  dynamic view monitor-check-flow {
    title 'Monitor check to notification flow'
    description 'Ordered flow of an active check: the server starts the check loop, the engine probes the target, records the heartbeat, triggers notifications on status change, providers deliver alerts, and live results stream to the dashboard.'
    serverCore -> monitorEngine {
      description 'Starts, restarts, and stops per-monitor check loops at server startup and on operator commands (startMonitors/startMonitor in server/server.js).'
    }
    monitorEngine -> monitoredTarget {
      description 'Each monitor type actively probes its configured target on an interval.'
    }
    monitorEngine -> heartbeatHistory {
      description 'Writes a heartbeat per check, reads the previous beat, and maintains aggregated uptime statistics.'
    }
    monitorEngine -> notificationHub {
      description 'On important status changes (and on the configured resend interval) the engine dispatches notifications, suppressed during maintenance.'
    }
    notificationHub -> notificationChannel {
      description 'The matching provider formats and delivers the message per channel.'
    }
    serverCore -> webApp {
      description 'Heartbeat results and aggregate statistics are pushed to connected dashboard sessions in real time.'
    }
  }
  dynamic view push-heartbeat-flow {
    title 'Push heartbeat flow'
    description 'Ordered flow of a passive push monitor: an external agent calls /api/push/:pushToken, the server records the heartbeat, and live status streams to the dashboard.'
    pushAgent -> serverCore {
      description 'Push monitors are satisfied by inbound calls instead of active probing (server/routers/api-router.js).'
    }
    serverCore -> heartbeatHistory {
      description 'Reads history for dashboards, badges, and status pages; records heartbeats received on the push endpoint.'
    }
    serverCore -> webApp {
      description 'Heartbeat results and aggregate statistics are pushed to connected dashboard sessions in real time.'
    }
  }
}
