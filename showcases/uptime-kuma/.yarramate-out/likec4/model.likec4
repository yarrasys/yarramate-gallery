model {
  appDatabase = systemSoftware 'Application database' {
    description 'Relational store accessed through knex and redbean-node (server/database.js). SQLite is the default (embedded kuma.db); MariaDB and embedded MariaDB are supported alternatives.'
    metadata {
      yarramateId 'uptime-kuma#app-database'
      yarramateKind 'yarramate/core@0.1#systemSoftware'
    }
  }
  dockerRuntime = node 'Docker runtime' {
    description 'Official deployment as the louislam/uptime-kuma container image: a single Node.js process (node server/server.js) exposing port 3001 with persistent state under the /app/data volume (compose.yaml, docker/dockerfile).'
    metadata {
      yarramateId 'uptime-kuma#docker-runtime'
      yarramateKind 'yarramate/core@0.1#node'
    }
  }
  heartbeatHistory = dataObject 'Heartbeat history' {
    description 'Per-check heartbeat records and aggregated uptime/response statistics (heartbeat and stat tables).'
    metadata {
      yarramateId 'uptime-kuma#heartbeat-history'
      yarramateKind 'yarramate/core@0.1#dataObject'
    }
  }
  metricsScraper = applicationComponent 'Metrics scraper' {
    description 'External Prometheus-compatible collector scraping the /metrics endpoint. Assumed consumer; only the endpoint is present in the repository.'
    metadata {
      yarramateId 'uptime-kuma#metrics-scraper'
      yarramateKind 'yarramate/core@0.1#applicationComponent'
    }
  }
  monitorConfig = dataObject 'Monitor configuration' {
    description 'Monitors, notification settings, users, tags, status pages, and maintenance windows as defined by the schema in db/knex_init_db.js and db/knex_migrations/.'
    metadata {
      yarramateId 'uptime-kuma#monitor-config'
      yarramateKind 'yarramate/core@0.1#dataObject'
    }
  }
  monitorEngine = applicationComponent 'Monitor engine' {
    description 'Per-monitor check loop (server/model/monitor.js) with pluggable check types under server/monitor-types/ (HTTP, TCP, DNS, ping, MQTT, SNMP, gRPC, databases, and more); computes uptime and drives alerting.'
    metadata {
      yarramateId 'uptime-kuma#monitor-engine'
      yarramateKind 'yarramate/core@0.1#applicationComponent'
    }
  }
  monitoredTarget = applicationComponent 'Monitored target' {
    description 'External service or host being probed. Outside the repository boundary; represented by the integration points in server/monitor-types/.'
    metadata {
      yarramateId 'uptime-kuma#monitored-target'
      yarramateKind 'yarramate/core@0.1#applicationComponent'
    }
  }
  notificationChannel = applicationService 'Notification channels' {
    description 'External delivery services (Telegram, Slack, SMTP, PagerDuty, webhooks, and others) that receive alert and recovery messages. Outside the repository boundary.'
    metadata {
      yarramateId 'uptime-kuma#notification-channel'
      yarramateKind 'yarramate/core@0.1#applicationService'
    }
  }
  notificationHub = applicationComponent 'Notification hub' {
    description 'Provider registry and dispatch (server/notification.js) fanning alerts out to ~99 notification provider integrations under server/notification-providers/.'
    metadata {
      yarramateId 'uptime-kuma#notification-hub'
      yarramateKind 'yarramate/core@0.1#applicationComponent'
    }
  }
  operator = businessActor 'Operator' {
    description 'Self-hosting administrator who signs in to the dashboard (JWT login with optional 2FA) to configure monitors, notifications, status pages, and maintenance windows.'
    metadata {
      yarramateId 'uptime-kuma#operator'
      yarramateKind 'yarramate/core@0.1#businessActor'
    }
  }
  pushAgent = applicationComponent 'Push agent' {
    description 'External system that reports its own liveness by calling the passive push endpoint /api/push/:pushToken. Outside the repository boundary.'
    metadata {
      yarramateId 'uptime-kuma#push-agent'
      yarramateKind 'yarramate/core@0.1#applicationComponent'
    }
  }
  serverCore = applicationComponent 'Server core' {
    description 'UptimeKumaServer singleton (server/uptime-kuma-server.js) wiring Express and Socket.IO; owns authentication, socket handlers, HTTP routers (status pages, badges, push endpoint, /metrics), and serves the built SPA.'
    metadata {
      yarramateId 'uptime-kuma#server-core'
      yarramateKind 'yarramate/core@0.1#applicationComponent'
    }
  }
  statusPublication = applicationService 'Status publication' {
    description 'Public status pages, incident history, SVG badges, and RSS feeds derived from monitor state.'
    metadata {
      yarramateId 'uptime-kuma#status-publication'
      yarramateKind 'yarramate/core@0.1#applicationService'
    }
  }
  statusVisitor = businessActor 'Status page visitor' {
    description 'Anonymous consumer of public status pages, badges, and RSS feeds; no authentication required.'
    metadata {
      yarramateId 'uptime-kuma#status-visitor'
      yarramateKind 'yarramate/core@0.1#businessActor'
    }
  }
  uptimeMonitoring = applicationService 'Uptime monitoring' {
    description 'Scheduled probing of configured targets with uptime history, response statistics, certificate expiry tracking, and alerting on status change.'
    metadata {
      yarramateId 'uptime-kuma#uptime-monitoring'
      yarramateKind 'yarramate/core@0.1#applicationService'
    }
  }
  webApp = applicationComponent 'Dashboard SPA' {
    description 'Vue 3 single-page application (src/) built with Vite; management UI and live charts, communicating with the server over Socket.IO.'
    metadata {
      yarramateId 'uptime-kuma#web-app'
      yarramateKind 'yarramate/core@0.1#applicationComponent'
    }
  }

  pushAgent -[flow]-> serverCore {
    description 'Push monitors are satisfied by inbound calls instead of active probing (server/routers/api-router.js).'
    metadata {
      yarramateId 'uptime-kuma#agent-pushes-heartbeat'
