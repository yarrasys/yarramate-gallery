views {
  view system-overview {
    title 'Uptime Kuma system overview'
    description 'Repository orientation: actors, services, application components, principal information, persistence, and the Docker deployment boundary of the current implementation.'
    include appDatabase, dockerRuntime, heartbeatHistory, metricsScraper, monitorConfig, monitorEngine, monitoredTarget, notificationChannel, notificationHub, operator, pushAgent, serverCore, statusPublication, statusVisitor, uptimeMonitoring, webApp
    exclude * -> *
    include * -> * where metadata.yarramateId is 'uptime-kuma#agent-pushes-heartbeat'
    include * -> * where metadata.yarramateId is 'uptime-kuma#core-accesses-heartbeats'
