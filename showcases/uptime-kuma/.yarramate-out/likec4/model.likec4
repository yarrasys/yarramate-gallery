  }
  serverCore -[flow]-> monitorEngine {
    description 'Starts, restarts, and stops per-monitor check loops at server startup and on operator commands (startMonitors/startMonitor in server/server.js).'
    metadata {
      yarramateId 'uptime-kuma#core-starts-monitors'
